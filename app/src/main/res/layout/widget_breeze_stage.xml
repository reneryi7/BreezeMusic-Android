<?xml version="1.0" encoding="utf-8"?>
<!-- 4×4 大屏与平板沉浸歌词舞台 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/bg_widget_concept" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingTop="16dp"
        android:paddingRight="18dp"
        android:paddingBottom="16dp">

        <!-- 顶部曲名 + 音质胶囊 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_song_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="#EEF3FA"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_quality_badge_img"
                android:layout_width="wrap_content"
                android:layout_height="17dp"
                android:layout_marginStart="6dp"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_song_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_idle_subtitle"
            android:textColor="#B7C5D9"
            android:textSize="12sp" />

        <!-- 中央大视觉舞台（黑胶封套 / 菱形棱镜光晕 / 水彩三叠卡） -->
        <ImageView
            android:id="@+id/widget_artwork_stage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/bg_widget_stage_art_preview" />

        <!-- 三行居中沉浸歌词区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_lyric_prev"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#8094A3B8"
                android:textSize="11.5sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_lyric_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/widget_idle_lyric"
                android:textColor="#8CC8FF"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_lyric_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#8094A3B8"
                android:textSize="11.5sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 胶囊进度条 -->
        <ImageView
            android:id="@+id/widget_progress_image"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="10dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <!-- 底部完整五键播控台：模式 / 上一首 / 播放暂停 / 下一首 / 红心喜欢 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_btn_play_mode"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@string/widget_cd_play_mode"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_mode_preview" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_btn_prev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/widget_cd_prev"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_prev_preview" />

            <ImageView
                android:id="@+id/widget_btn_play"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:contentDescription="@string/widget_cd_play_pause"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_play_preview" />

            <ImageView
                android:id="@+id/widget_btn_next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/widget_cd_next"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_next_preview" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_btn_favorite"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@string/widget_cd_favorite"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_heart_preview" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
