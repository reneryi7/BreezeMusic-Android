<?xml version="1.0" encoding="utf-8"?>
<!-- 车机专版 4×2 暗色流光玻璃桌面播控卡（高对比度、超大触控盲操热区，适配 DiLink / 嘟嘟桌面 / CarWebGuru） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/bg_widget_concept" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="14dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_artwork_stage"
                android:layout_width="118dp"
                android:layout_height="92dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/bg_widget_stage_art_preview" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_song_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/app_name"
                        android:textColor="#F6FAFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/widget_quality_badge_img"
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_song_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_idle_subtitle"
                    android:textColor="#C5D5EA"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/widget_lyric_line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_idle_lyric"
                    android:textColor="#66E3FF"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_btn_favorite"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@string/widget_cd_favorite"
                        android:padding="4dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_widget_heart_preview" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/widget_btn_prev"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:contentDescription="@string/widget_cd_prev"
                        android:padding="4dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_widget_prev_preview" />

                    <ImageView
                        android:id="@+id/widget_btn_play"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="@string/widget_cd_play_pause"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_widget_play_preview" />

                    <ImageView
                        android:id="@+id/widget_btn_next"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:contentDescription="@string/widget_cd_next"
                        android:padding="4dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_widget_next_preview" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_progress_image"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
